{
  "name": "jaenvtix",
  "displayName": "jaenvtix",
  "description": "Jaenvtix — Auto‑Setup (JDK & Maven) for Visual Studio Code",
  "publisher": "naervyx",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:jaenvtix.setup"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Jaenvtix",
      "properties": {
        "jaenvtix.pythonPath": {
          "type": "string",
          "default": "python",
          "markdownDescription": "Caminho completo para o executável **Python** usado pelo Jaenvtix."
        },
        "jaenvtix.setupTimeout": {
          "type": "number",
          "default": 300,
          "markdownDescription": "Tempo limite em segundos para aguardar a conclusão da configuração automática de JDK e Maven."
        },
        "jaenvtix.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "markdownDescription": "Nível de detalhamento do log emitido pelo Jaenvtix (`error`, `warn`, `info`, `debug`)."
        }
      }
    },
    "commands": [
      {
        "command": "jaenvtix.setup",
        "title": "Jaenvtix: Setup JDK and Maven"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsix": "npm run package && npx @vscode/vsce package --out jaenvtix.vsix",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/src/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sinon": "^17.0.3",
    "@vscode/vsce": "^2.29.0",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^10.7.3",
    "sinon": "^17.0.2"
  }
}
