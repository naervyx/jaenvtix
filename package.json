{
	"name": "jaenvtix",
	"displayName": "Jaenvtix",
	"description": "Automatic Setup for Java Projects in Visual Studio Code",
	"publisher": "naervyx",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "notifications-sample.showInfo",
				"title": "Show Info Notification",
				"category": "Notifications Sample"
			}
		]
	},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/vscode": "^1.100.0",
    "@types/node": "^25.0.2",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^9.13.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}