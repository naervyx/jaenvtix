{
        "compilerOptions": {
                "module": "Node16",
                "moduleResolution": "Node16",
                "target": "ES2022",
                "lib": [
                        "ES2022"
                ],
                "sourceMap": true,
                "rootDir": ".",
                "outDir": "out",
                "strict": true,
                "esModuleInterop": true,
                "types": [
                        "node",
                        "vscode",
                        "mocha"
                ]
        },
        "include": [
                "src/**/*"
        ]
}
